{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Heatmap",
  "identifier": "app.diskheatmap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disk Heatmap",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDRTc0MzU2MjA1Q0UyNzQKUldSMDRsd2dWa1BuTENYRlRrRENOS3hqS3ZSZUtPYkFjRFhhdGJ6RjVQb0VWMklMcHBEOW1CQ3YK",
      "endpoints": [
        "https://github.com/Anuraj-dev/disk-space-heatmap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
